# Postgres connection (AWS RDS in production). Unset = local embedded PGlite.
DATABASE_URL=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes stored SSNs/passwords unreadable. Keep it in AWS Secrets Manager.
APP_ENCRYPTION_KEY=
# First admin created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
